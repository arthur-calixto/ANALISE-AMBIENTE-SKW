# Diretório compartilhado onde o server-tool.sh grava as sessões
# (montado como volume dentro do container)
SHARED_DIR=/app/data

# Host/porta em que a aplicação web sobe
APP_HOST=0.0.0.0
APP_PORT=8000

# Base URL usada pelo server-tool.sh para montar o link retornado ao usuário
# Ex: http://analise-ambiente.interno:8000
PUBLIC_BASE_URL=http://localhost:8000
