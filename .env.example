# Diretório com os arquivos <NOME_CLIENTE>.json (credenciais de conexão).
# Local (venv, fora do Docker): ./data
# Dentro do container Docker: /app/data (já forçado via docker-compose.yml,
# não precisa mudar esse valor pra rodar com Docker)
SHARED_DIR=./data

# Host/porta em que a aplicação web sobe
APP_HOST=0.0.0.0
APP_PORT=8000

# Base URL usada pelo server-tool.sh para montar o link retornado ao usuário
# Ex: http://analise-ambiente.interno:8000
PUBLIC_BASE_URL=http://localhost:8000
