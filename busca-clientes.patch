                 <div class="ir">Abrir →</div>
             </a>
         </div>
+
+        {% if clientes %}
+        <section class="busca-clientes">
+            <h2>Selecionar cliente</h2>
+            <div class="campo-busca">
+                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
+                    <circle cx="11" cy="11" r="7"></circle>
+                    <path d="M21 21l-4.3-4.3"></path>
+                </svg>
+                <input type="text" id="busca-cliente" placeholder="buscar cliente..." autocomplete="off" autofocus>
+            </div>
+            <div class="contador-clientes" id="contador-clientes"></div>
+            <div class="grid-clientes" id="grid-clientes">
+                {% for cliente in clientes %}
+                <a class="cliente-item" href="/analise/{{ cliente }}" data-nome="{{ cliente|lower }}">
+                    <span class="nome">{{ cliente }}</span> <span class="seta">→</span>
+                </a>
+                {% endfor %}
+            </div>
+            <div class="sem-resultado" id="sem-resultado" style="display:none;">Nenhum cliente encontrado.</div>
+        </section>
+        {% else %}
+        <div class="sem-clientes">
+            Nenhum cliente encontrado. Adicione um arquivo <code>NOME_CLIENTE.json</code>
+            no diretório compartilhado (<code>SHARED_DIR</code>) com as credenciais de conexão.
+        </div>
+        {% endif %}
     </main>
+
+    <script>
+        const input = document.getElementById("busca-cliente");
+        const itens = Array.from(document.querySelectorAll(".cliente-item"));
+        const contador = document.getElementById("contador-clientes");
+        const semResultado = document.getElementById("sem-resultado");
+
+        function atualizarContador(visiveis) {
+            contador.textContent = `${visiveis} de ${itens.length} clientes`;
+        }
+
+        if (input) {
+            atualizarContador(itens.length);
+
+            input.addEventListener("input", () => {
+                const termo = input.value.trim().toLowerCase();
+                let visiveis = 0;
+
+                itens.forEach(item => {
+                    const nome = item.dataset.nome;
+                    const bate = nome.includes(termo);
+                    item.style.display = bate ? "" : "none";
+                    if (bate) visiveis++;
+                });
+
+                atualizarContador(visiveis);
+                semResultado.style.display = visiveis === 0 ? "block" : "none";
+            });
+
+            input.addEventListener("keydown", (ev) => {
+                if (ev.key === "Enter") {
+                    const primeiroVisivel = itens.find(i => i.style.display !== "none");
+                    if (primeiroVisivel) window.location.href = primeiroVisivel.getAttribute("href");
+                }
+            });
+        }
+    </script>
